# Contest-only Google Cloud project; never use an employer project.
GOOGLE_CLOUD_PROJECT=replace-with-contest-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-flash-latest

# Contest-only Grafana Cloud stack and least-privilege service account.
GRAFANA_URL=https://replace-with-stack.grafana.net
GRAFANA_SERVICE_ACCOUNT_TOKEN=replace-locally-never-commit
MCP_GRAFANA_BIN=mcp-grafana

# Optional hosted service configuration.
PORT=8080
